cabal-version:      3.0
name:               dilema-crawler
version:            0.1.0.0
build-type:         Simple

executable dilema-crawler
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -O2
  build-depends:
      base >=4.18 && <5
    , bytestring
    , process
    , tagsoup
    , text
